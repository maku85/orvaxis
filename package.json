{
  "name": "orvaxis",
  "version": "0.4.0",
  "description": "Lightweight policy-driven execution runtime for Node.js",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/esm/testing.d.ts",
        "default": "./dist/esm/testing.js"
      },
      "require": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      }
    },
    "./express": {
      "import": {
        "types": "./dist/esm/express.d.ts",
        "default": "./dist/esm/express.js"
      },
      "require": {
        "types": "./dist/express.d.ts",
        "default": "./dist/express.js"
      }
    },
    "./fastify": {
      "import": {
        "types": "./dist/esm/fastify.d.ts",
        "default": "./dist/esm/fastify.js"
      },
      "require": {
        "types": "./dist/fastify.d.ts",
        "default": "./dist/fastify.js"
      }
    },
    "./otel": {
      "import": {
        "types": "./dist/esm/otel.d.ts",
        "default": "./dist/esm/otel.js"
      },
      "require": {
        "types": "./dist/otel.d.ts",
        "default": "./dist/otel.js"
      }
    },
    "./openapi": {
      "import": {
        "types": "./dist/esm/openapi.d.ts",
        "default": "./dist/esm/openapi.js"
      },
      "require": {
        "types": "./dist/openapi.d.ts",
        "default": "./dist/openapi.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "homepage": "https://maku85.github.io/orvaxis/",
  "repository": {
    "type": "git",
    "url": "https://github.com/maku85/orvaxis.git"
  },
  "keywords": [
    "policy",
    "policy-engine",
    "middleware",
    "router",
    "runtime",
    "express",
    "fastify",
    "nodejs",
    "typescript",
    "http",
    "observability",
    "opentelemetry",
    "sse",
    "server-sent-events",
    "graceful-shutdown"
  ],
  "scripts": {
    "dev": "tsx examples/express-server.ts",
    "docs:dev": "tsx scripts/generate-policy-demo.ts && vitepress dev docs",
    "docs:build": "tsx scripts/generate-policy-demo.ts && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "build:cjs": "tsc -p tsconfig.json",
    "build:esm": "tsc -p tsconfig.esm.json && node -e \"require('fs').writeFileSync('dist/esm/package.json', JSON.stringify({type:'module'}))\"",
    "build": "pnpm build:cjs && pnpm build:esm",
    "check:package": "node scripts/check-package.mjs",
    "test:compat": "node scripts/run-compat.mjs",
    "typecheck:compat": "tsc -p tsconfig.compat-express4.json",
    "check:docs-assets": "node scripts/check-docs-assets.mjs",
    "lint": "biome lint .",
    "format": "biome format . --write",
    "check": "biome check .",
    "typecheck:tests": "tsc --noEmit -p tsconfig.type-tests.json",
    "check:tenant-demo": "tsx examples/tenant-tasks-check.ts",
    "check:protection": "tsx examples/protection-report.ts --baseline examples/fixtures/tenant-tasks-protection.json --fail-on policy-removed,policy-weakened",
    "update:protection-baseline": "tsx examples/protection-report.ts --baseline examples/fixtures/tenant-tasks-protection.json --update",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest bench benchmarks/",
    "bench:run": "vitest bench run benchmarks/",
    "bench:save": "tsx benchmarks/compare.ts --save",
    "bench:compare": "tsx benchmarks/compare.ts --compare",
    "prepublishOnly": "npm run check && tsc --noEmit && npm run typecheck:tests && npm run test && npm run build && npm run check:package",
    "release": "bash scripts/release.sh patch",
    "release:minor": "bash scripts/release.sh minor",
    "release:major": "bash scripts/release.sh major",
    "release:alpha": "bash scripts/release.sh prerelease alpha"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.0.0",
    "express": "^4.20.0 || ^5.0.0",
    "fastify": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@opentelemetry/api": "^1.9.1",
    "@types/express": "^5.0.6",
    "@types/express4": "npm:@types/express@^4.17.25",
    "@vitest/coverage-v8": "^4.1.5",
    "express4": "npm:express@^4.22.1",
    "express5": "npm:express@^5.2.1",
    "fastify": "^5.8.5",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.5",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.1.2"
}
